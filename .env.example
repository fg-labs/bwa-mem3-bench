# Example environment for bwa-mem3-bench. Copy to `.env` (gitignored) and
# source with `set -a; source .env; set +a` before running CLI commands, or
# export each variable directly. Most variables have working defaults — only
# REF_ROOT (for `upload-data --what references`) is strictly required.

# ─── AWS infrastructure ──────────────────────────────────────────────────────
# Populated automatically by `cdk deploy` into cdk/outputs.json. Set these
# explicitly if you don't have outputs.json (e.g. running CLI on a host that
# didn't run `cdk deploy` itself).

# S3 bucket holding references / fastqs / runs / baselines.
# BWA_MEM3_BENCH_S3_BUCKET=my-bwa-mem3-bench-bucket

# ECR repository URI for the bwa-mem3-bench Docker image.
# BWA_MEM3_BENCH_ECR_REPO=123456789012.dkr.ecr.us-east-1.amazonaws.com/bwa-mem3-bench

# AWS Batch IAM role ARN attached to spawned worker jobs.
# SNAKEMAKE_AWS_BATCH_JOB_ROLE=arn:aws:iam::123456789012:role/bwa-mem3-bench-job-role

# AWS Batch coordinator queue + job-definition names. Defaults match the
# names produced by cdk/stacks/batch_stack.py.
# BWA_MEM3_BENCH_COORDINATOR_QUEUE=bwa-mem3-bench-coordinator
# BWA_MEM3_BENCH_COORDINATOR_JOB_DEF=bwa-mem3-bench-coordinator

# AWS region. Default us-east-1.
# AWS_REGION=us-east-1

# ─── CDK context ─────────────────────────────────────────────────────────────
# Optional cost-center tag applied to every CDK-managed resource and to
# spawned Batch worker jobs. Set as CDK context via `cdk deploy -c cost_center=...`
# (preferred) or via this env var, which gets passed through if you wrap cdk in
# a script. Unset = no Cost Center tag emitted.
# BWA_MEM3_BENCH_COST_CENTER=Your Cost Center
# CDK_CONTEXT_JSON='{"cost_center":"Your Cost Center"}'

# ─── Local data staging ──────────────────────────────────────────────────────

# Directory holding the Broad hg38 bundle and bwa-mem2 indexes. Required by
# `cli upload-data --what references` (consumed by scripts/upload_reference.sh).
# See docs/data-setup.md for download instructions.
# REF_ROOT=/path/to/Homo_sapiens_assembly38

# Directory holding raw vendor FASTQs (twist-umi_{1,2}.fastq.gz, etc.). Used by
# `cli upload-data --what data`. Defaults to ./vendor-fastqs (gitignored).
# BWA_MEM3_BENCH_VENDOR_ROOT=/path/to/vendor-fastqs

# Scratch directory for downsampled FASTQs written by `upload-data` and for
# 1000 Genomes WGS/WES extracts. Defaults to ./data-stage (gitignored).
# BWA_MEM3_BENCH_STAGE_ROOT=/path/to/data-stage

# Local mirror of the S3 bucket (used by `cli sync-local` and `cli collect`).
# Defaults to ./local-mirror (gitignored). Override to e.g. an external SSD.
# BWA_MEM3_BENCH_LOCAL_MIRROR=/path/to/local-mirror
