"""bwa-mem3-bench Snakemake workflow.

AWS smoke (one baseline job + one fg-labs job + compare, via AWS Batch):
    snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
        --config fg_labs_sha=<sha> -- smoke

Full AWS run:
    snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
        --config fg_labs_sha=<sha> archs=c8g,c6a,c7i reps=1

Baseline bless (one-time per upstream version):
    snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
        --config upstream_tag=v2.2.1 reps=5 -- baseline_all
"""

import sys
from pathlib import Path

# Make the Python package importable from the repo root.
sys.path.insert(0, str(Path(workflow.basedir).parent))

from bwa_mem3_bench.workflow_config import (
    compat_sample_suffix,
    load_config,
    parse_ladder_override,
)


CONFIG = load_config(Path(workflow.basedir).parent / "config")

# -- Parameters from --config
FG_LABS_SHA = config.get("fg_labs_sha", "MISSING")
ARCHS = config.get("archs", CONFIG.core_arch).split(",")
SAMPLES = config.get("samples", ",".join(CONFIG.samples.keys())).split(",")
REPS = int(config.get("reps", CONFIG.reps_default))
REPS_BASELINE = int(config.get("reps_baseline", CONFIG.reps_baseline))
# Pinned previous-release SHA for the vs-golden (Gate #2) comparison. Empty
# disables vs-golden — `compare_vs_golden` only fires when this is set, and it
# reads golden/fg-labs-<GOLDEN_REF_SHA>/ (not the run's own SHA).
GOLDEN_REF_SHA = config.get("golden_ref_sha", "")
BASELINE_ONLY = str(config.get("baseline_only", "false")).lower() == "true"
IMAGE = config.get("image_tag", f"bwa-mem3-bench:{FG_LABS_SHA}")

# ---------------------------------------------------------------------------
# Per-rule image selection.
#
# Each Batch worker pulls a different ECR image based on its arch:
#   - portable (c7g, c8g): the bare `<sha>` tag — multi-arch manifest list
#     (linux/amd64 + linux/arm64), `BASELINE_ARCH=avx2` x86 build.
#   - avx2 (c6a):     `<sha>-avx2` (explicit, same content as portable today).
#   - avx512bw-locked (c7a, c7i, m7i): `<sha>-avx512bw` — linux/amd64 only,
#     non-kernel TUs compiled at AVX-512BW for ~10-15% better hot-path perf
#     on AVX-512 hosts (fg-labs/bwa-mem3 PR #84). Crashes on AVX2-only hosts.
#
# The mapping is driven by `arch.baseline_arch` in `config/archs.yaml`. Each
# rule's `resources.container_image` lambda calls `image_for_arch` below;
# our snakemake-executor-plugin-aws-batch fork reads the resource and uses
# it as the SubmitJob job-def's `containerProperties.image`. When unset
# (e.g. future rules that don't care about arch), the profile's
# `container-image` falls back. Build-side: `cli build --baseline-arch
# <tier>` produces the matching ECR tag.
# ---------------------------------------------------------------------------

from bwa_mem3_bench import aws_config as _aws_config
from bwa_mem3_bench import minibwa_sha as _minibwa_sha
from bwa_mem3_bench.golden import golden_backed_samples

_AWS = _aws_config.load()
_ECR_REPO_URI = _AWS.ecr_repo_uri

# Bucket for the golden listing below. On the coordinator `aws_config.load()`
# resolves the bucket from the Batch job-def env; worker jobs re-parse this
# Snakefile WITHOUT that env and would fall back to the wrong default bucket
# (NoSuchBucket → the golden-gated run aborts). The coordinator threads the
# bucket through the `s3_bucket` config key, and snakemake config propagates to
# workers (unlike the job-def env), so prefer it. See coordinator-entrypoint.sh.
_S3_BUCKET = config.get("s3_bucket") or _AWS.bucket

# Samples the pinned golden actually contains. A golden blessed before a sample
# existed (e.g. the v0.2.2 golden predates hic-1M / sbx-1M) lacks that sample's
# BAM, so requesting vs-golden for it would make `rule all` unsatisfiable. We
# scope vs-golden to this set. Empty unless a golden is pinned (no S3 call then).
GOLDEN_SAMPLES = (
    golden_backed_samples(_S3_BUCKET, GOLDEN_REF_SHA)
    if GOLDEN_REF_SHA and GOLDEN_REF_SHA != FG_LABS_SHA
    else frozenset()
)


def image_for_arch(arch_name: str) -> str:
    """Fully-qualified ECR image URI for a worker on `arch_name`."""
    return CONFIG.archs[arch_name].image_uri(
        ecr_repo_uri=_ECR_REPO_URI,
        fg_labs_sha=FG_LABS_SHA,
    )


# Upstream bwa-mem2 v2.2.1 only supports x86. Anything that needs
# `bwa-mem2.upstream` (align_baseline, compare_vs_baseline) is restricted to
# baseline-supported archs; arm archs get fg-labs alignments only (and
# eventually compare_vs_golden once a golden exists).
BASELINE_ARCHS = [a for a in ARCHS if CONFIG.archs[a].platform == "linux/amd64"]
ARM_ARCHS = [a for a in ARCHS if CONFIG.archs[a].platform == "linux/arm64"]
# Archs the minibwa probe runs on (private/minibwa-bench branch only). Drops
# m7i, which exists in full_archs only for meth-FMI memory headroom — minibwa
# has no meth path. Every other arch in the user's selection is kept so
# per-SIMD differences stay visible.
MINIBWA_ARCHS = [a for a in ARCHS if a != "m7i"]
# Pinned lh3/minibwa SHA (canonical source: docker/build-arg-defaults.env).
# minibwa cache outputs live under `minibwa/<MINIBWA_SHA>/...`, so they are
# only re-aligned when the vendored submodule (and this SHA) is bumped.
MINIBWA_SHA = _minibwa_sha()

RUNS_DIR = Path(f"runs/{FG_LABS_SHA}")

wildcard_constraints:
    sample      = "[A-Za-z0-9_-]+",
    arch        = "[a-z0-9]+",
    rep         = r"\d+",
    minibwa_sha = "[0-9a-f]+",
    # `align_bwa`'s cache key -- a bwa release string ("0.7.19"). Constrained for
    # the same reason `minibwa_sha` is: the default `.+` matches `/`, so an
    # unconstrained version wildcard can swallow path segments.
    tool_version = r"[0-9A-Za-z._-]+",
    tool        = "fg-labs|baseline|minibwa"

include: "rules/align.smk"
include: "rules/compare.smk"
include: "rules/align_minibwa.smk"
include: "rules/align_bwa.smk"
include: "rules/eval.smk"
include: "rules/scaling.smk"


# Aggregator targets have no shell body, so they always run on the coordinator.
#
# NOTE: host metadata is deliberately NOT a localrule (and no longer a rule at
# all). The old `emit_meta` lived here for cost reasons — "a tiny JSON write, no
# point burning a worker spin-up" — but running on the coordinator meant it
# recorded the COORDINATOR's instance identity, so an m7i job reported
# `instance_type: c6a.large` and two different m7i workers shared one
# instance_id. It is now written by the align rules themselves via
# `emit-host-meta`, which is the only place guaranteed to be the machine that
# ran the alignment.
localrules:
    all,
    baseline_all,
    bless_release,
    smoke,
    smoke_meth,
    minibwa,
    minibwa_smoke,
    accuracy,
    accuracy_smoke,
    fast,
    fast_meth,
    fast_smoke,
    thread_scaling,
    compat,
    compat_smoke,
    compat_bwa_smoke,
    compat_bwa,
    compat_alt,


def _is_meth_sample(sample_name: str) -> bool:
    # Single meth predicate — delegates to Sample.is_meth (config-validated to
    # agree with the sample's reference; see Sample.__post_init__).
    return CONFIG.samples[sample_name].is_meth


def _archs_for_sample(sample_name: str) -> list:
    """Meth samples run only on m7i (needs ~50 GB container RAM for the doubled
    meth FMI, doesn't fit on c7i.4xlarge's 32 GB host); non-meth samples run
    across all baseline-supported x86 archs in the user's selection so we get
    per-SIMD perf numbers."""
    if _is_meth_sample(sample_name):
        return [a for a in BASELINE_ARCHS if a == "m7i"]
    return BASELINE_ARCHS


# Samples in the speed/concordance sweep (`rule all`, `baseline_all`). Truth
# (sim-*) samples are excluded — they have no upstream-concordance question and
# are driven by the `accuracy` / `accuracy_smoke` targets instead (eval.smk).
# `--fast`-preset siblings (`*-fast`) are also excluded — they are driven only
# by the opt-in `fast` target (see FAST_* below), which adds the fast-vs-default
# concordance the standard sweep does not produce; keeping them out leaves
# `rule all` / `baseline_all` / `accuracy` byte-for-byte unchanged.
def _is_fast_sample(sample_name: str) -> bool:
    return sample_name.endswith("-fast")


def _is_compat_sample(sample_name: str) -> bool:
    """Whether this is a `--compat=bwa-mem2` sibling.

    Keyed off the resolved flag rather than the name suffix (unlike
    `_is_fast_sample`) so the predicate and the strict tag policy in
    `WorkflowConfig.ignore_tags()` read the same fact. The two are kept in
    agreement by `_validate_compat_siblings`, which requires the suffix.
    """
    return CONFIG.samples[sample_name].is_compat


def _is_alt_sample(sample_name: str) -> bool:
    """Whether this sample stages the `.alt` sidecar (ALT-aware mapping).

    Keyed off the resolved flag, same as `_is_compat_sample`, so the predicate
    reads the fact the staging in `_ref_inputs` actually keys off rather than a
    name convention.
    """
    return CONFIG.samples[sample_name].alt_aware


SWEEP_SAMPLES = [
    s
    for s in SAMPLES
    if not CONFIG.samples[s].truth
    and not _is_fast_sample(s)
    and not _is_compat_sample(s)
    # ALT-aware arms are driven by `--target compat_alt` alone. The compat
    # SIBLINGS are already excluded above, but their base (`wgs-5M-alt`) is a
    # plain sample and would otherwise join the sweep -- where all three of the
    # sweep's comparisons are wrong for it. `vs_golden` has no ALT-aware BAM to
    # compare against (the blessed corpus predates the sample); `vs_baseline`
    # runs compare-bams under an `expect_tags` allowlist that deliberately omits
    # `pa`, which is precisely the tag ALT-aware mapping emits, so it would fail
    # BY NAME; and `bench regression` diffs `all` against the golden's, so a new
    # member silently changes what Gate #1 compares. Under `compat_alt` every
    # comparison is `fgumi compare bams` against an upstream computed with the
    # same flag, which is sound.
    and not _is_alt_sample(s)
]


# ---------------------------------------------------------------------------
# Truth-based accuracy targets (holodeck eval). Accuracy is a property of the
# aligner build and is ~arch-invariant, so — unlike the timing sweep — we do
# NOT stratify by arch: each chemistry is pinned to a single arch. Non-meth runs
# on the cheapest baseline-supported x86 (c6a); meth runs on m7i, the only arch
# with RAM for the doubled meth FMI.
# ---------------------------------------------------------------------------
_ACCURACY_ARCH_NONMETH = "c6a"
_ACCURACY_ARCH_METH = "m7i"

# Sourced from SAMPLES (not CONFIG.samples) so `--config samples=` scopes the
# accuracy run too, symmetric with SWEEP_SAMPLES. SAMPLES defaults to every
# config sample, so an unscoped `accuracy` run still covers all sim datasets.
SIM_SAMPLES = [
    s for s in SAMPLES if CONFIG.samples[s].truth and not _is_fast_sample(s)
]
SMOKE_SIM_SAMPLES = [s for s in SIM_SAMPLES if s.startswith("sim-smoke-")]
FULL_SIM_SAMPLES = [s for s in SIM_SAMPLES if not s.startswith("sim-smoke-")]


def _accuracy_arch(sample_name: str) -> str:
    return _ACCURACY_ARCH_METH if _is_meth_sample(sample_name) else _ACCURACY_ARCH_NONMETH


def _accuracy_targets(samples: list, reps: int) -> list:
    """Eval-output sentinels (`.variants.tsv`) for the accuracy matrix.

    Per dataset the arms are:
      - fg-labs: every sim sample (the genomic D3 arm is its own sample sharing
        truth + FASTQs with its collapsed sibling).
      - baseline: the primary (non-genomic) arm only — bwa-mem2 upstream for
        non-meth, bwameth for meth.
      - minibwa: every primary (non-genomic) arm, meth included. On meth samples
        minibwa is the naive 4-letter aligner (no bisulfite mode): it aligns the
        EM-seq reads against the plain DNA index and is scored on placement +
        variant representation (methylation correlation is NA — no XM tags), so
        the meth comparison has all four arms (minibwa / bwameth / D3-collapsed /
        D3-genomic). The genomic D3 arm is a re-scored sibling sample, so it
        carries only the fg-labs output — baseline and minibwa would be byte-for-
        byte identical to the collapsed arm's.
    Requesting one of the eval rule's three outputs pulls the whole rule.
    """
    targets = []
    for sample in samples:
        arch = _accuracy_arch(sample)
        # Secondary fg-labs arms (a `*-genomic` meth-scoring sibling or a
        # `*-fast` preset sibling) re-score / re-run the SAME source FASTQs as
        # their primary sample, so their baseline + minibwa arms would be
        # byte-identical to the primary's — request only the fg-labs arm for
        # them and let the primary carry the shared baseline/minibwa grades.
        flags = CONFIG.samples[sample].fg_labs_flags
        secondary = "genomic" in flags or "--fast" in flags
        for rep in range(1, reps + 1):
            base = f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/eval"
            targets.append(f"{base}/fg-labs.variants.tsv")
            if not secondary:
                targets.append(f"{base}/baseline.variants.tsv")
                targets.append(f"{base}/minibwa.variants.tsv")
    return targets


# ---------------------------------------------------------------------------
# `--fast` preset benchmark (fg-labs/bwa-mem3 PR #189). Opt-in `fast` target.
#
# For each base sample we run BOTH the default arm and its `<base>-fast` sibling
# at the SAME fg-labs SHA, so default-vs-fast isolates the preset on a
# byte-identical binary. Deliverables:
#   - wall + peak RSS: each arm's tricord timing.tsv (ingested per-sample).
#   - upstream/bwameth concordance + drift: the default arm's vs-baseline.json
#     (x86) / vs-x86.json (arm), exactly as `rule all`.
#   - fast-vs-default concordance (the headline, MAPQ-stratified): the fast
#     arm's vs-default.json on every arch the default arm runs on.
#   - truth-based sensitivity/specificity/MAPQ/meth-corr for the sim siblings.
#
# minibwa is reused untouched — cached by MINIBWA_SHA, independent of the
# fg-labs SHA — so `--target fast` re-aligns nothing on the minibwa side.
# ---------------------------------------------------------------------------
# Real-data bases (speed + memory + concordance); each needs a `*-fast` sibling.
# Every real dataset the benchmark carries, so `--fast` is compared on all of
# them. Non-meth bases sweep all arches (via _archs_for_sample + ARM); meth is
# pinned to m7i — the only bench arch with enough RAM (~48 GB) for the doubled
# meth FMI, so a cross-microarch meth sweep would need larger instances (infra
# change), not just a target edit.
FAST_REAL_BASES = [
    "wgs-5M",
    "wes-5M",
    "panel-twist-5M",
    "hic-1M",
    "sbx-1M",
    "meth-twist-emseq-5M",
]
# Truth bases (holodeck-graded accuracy).
FAST_SIM_BASES = ["sim-wgs-place", "sim-wgs-vars", "sim-meth-place", "sim-meth-vars"]


def _fast_speed_targets() -> list:
    """Sentinels for the real-data fast benchmark: default-arm upstream
    concordance + both arms' timing + the fast-vs-default headline concordance.
    """
    targets = []
    for base in FAST_REAL_BASES:
        fast = f"{base}-fast"
        meth = _is_meth_sample(base)
        # Default arm at this SHA — mirror `rule all`: vs-baseline on x86 (pulls
        # the upstream baseline + the default fg-labs BAM/timing), vs-x86 on arm
        # (transitive concordance + arm timing; non-meth only).
        for arch in _archs_for_sample(base):
            for rep in range(1, REPS + 1):
                targets.append(
                    f"runs/{FG_LABS_SHA}/{base}/{arch}/rep-{rep}/compare/vs-baseline.json"
                )
            for rep in range(1, REPS_BASELINE + 1):
                targets.append(
                    f"baseline/bwa-mem2-{CONFIG.upstream_tag}/{base}/{arch}/rep-{rep}/aligned.bam"
                )
        if not meth:
            for arch in ARM_ARCHS:
                for rep in range(1, REPS + 1):
                    targets.append(
                        f"runs/{FG_LABS_SHA}/{base}/{arch}/rep-{rep}/compare/vs-x86.json"
                    )
        # Fast arm: headline fast-vs-default concordance on every arch the
        # default arm runs on. vs-default pulls the fast BAM/timing as its query
        # and the default BAM as its baseline, so no redundant fast-arm upstream
        # alignment is paid.
        fast_archs = list(_archs_for_sample(base)) + ([] if meth else list(ARM_ARCHS))
        for arch in fast_archs:
            for rep in range(1, REPS + 1):
                targets.append(
                    f"runs/{FG_LABS_SHA}/{fast}/{arch}/rep-{rep}/compare/vs-default.json"
                )
    return targets


def _fast_accuracy_targets() -> list:
    """Truth-based accuracy for the sim bases (full arms: fg-labs + baseline +
    minibwa) plus their `*-fast` siblings (fg-labs-only — _accuracy_targets
    treats `--fast` as a secondary arm sharing the primary's source)."""
    return _accuracy_targets(FAST_SIM_BASES, REPS) + _accuracy_targets(
        [f"{b}-fast" for b in FAST_SIM_BASES], REPS
    )


def _compat_targets(samples: list, reps: int) -> list:
    """Byte-identity arms: `--compat=bwa-mem2` scored against upstream bwa-mem2
    with an EMPTY ignore list, on every arch.

    Two things distinguish this from the sweep's own `vs_baseline`:

    * The tag policy is strict. The sweep excludes MQ/HN because default-mode
      bwa-mem3 emits them and bwa-mem2 does not, so its 100% is
      "identical-modulo-two-tags". `--compat` suppresses exactly those, so the
      exclusion can go away and the score becomes byte-identity.
    * It runs on ARM as well as x86. `rule all` sends ARM to `vs_x86` because
      upstream has no ARM build, which leaves NEON's compat behaviour untested
      — and NEON is one of the two tiers carrying the known phantom-XS defect
      (fg-labs/bwa-mem3#290). The ARM arms are scored against the x86 baseline;
      `compare_vs_baseline` handles that fallback.

    Baseline BAMs are NOT requested here: the compat sibling aliases onto its
    base sample's baseline, which `rule all` already produces.

    Two outputs per cell, deliberately:

    * `compat-identity.txt` — `fgumi compare bams`, the GATE. All eleven core SAM
      fields plus tags, with @HD/@SQ/@RG compatibility enforced; boolean, so a
      difference fails the run. This is what makes the byte-identity claim.
    * `vs-baseline.json` — `compare-bams`, for the DB and trend reporting. Graded,
      and narrower (placement + tags only), so it cannot carry the claim on its
      own — but it is what `collect` ingests and what the concordance tables show.

    Keeping both means the strict assertion is enforced without losing the cell
    from `benchmark.db`.
    """
    return [
        f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/{output}"
        for sample in samples
        for arch in ARCHS
        for rep in range(1, reps + 1)
        for output in ("compat-identity.txt", "vs-baseline.json")
    ]


def _compat_bwa_targets(samples: list, reps: int) -> list:
    """`--compat=bwa-mem` byte-identity arms, scored against lh3/bwa.

    One output per cell, not two. The bwa-mem2 arm also emits `vs-baseline.json`
    so the cell survives in `benchmark.db`, but that file is produced by the
    SWEEP for the base sample already, and a graded score against the bwa-mem2
    baseline says nothing about bwa parity -- this arm retains MQ:i, so its
    vs_baseline number would be the base sample's with extra steps.

    `ARCHS`, not `BASELINE_ARCHS`: bwa builds on arm64 (NEON since 0.7.18), so
    unlike the bwa-mem2 arm this compares same-arch against same-arch with no
    transitive step. See rules/align_bwa.smk.
    """
    return [
        f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/bwa-identity.txt"
        for sample in samples
        for arch in ARCHS
        for rep in range(1, reps + 1)
    ]


# The datasets both compat arms are scored on. ONE literal, because the two
# arms must cover the same bases -- "bwa-mem2 parity implies bwa parity" is
# otherwise claimed on a wider set than it was measured on. Two copies would
# have to be kept in step by hand; deriving both from here makes the drift
# impossible to write. `test_bwa_arm_covers_every_compat_cell_on_every_arch`
# still has teeth, because the `in CONFIG.samples` filters below can diverge
# on their own if only one arm's sibling is declared in samples.yaml.
COMPAT_BASE_SAMPLES = (
    "wgs-5M",
    "wes-5M",
    "panel-twist-5M",
    "hic-1M",
    "sbx-1M",
    # Simulated (holodeck) siblings: the only non-meth datasets that lacked a
    # compat arm, and a different error profile from the 1000 Genomes / Twist
    # real data. Their baselines already exist (the accuracy target produces
    # them), so scoring them costs only the compat alignments.
    "sim-wgs-place",
    "sim-wgs-vars",
)


COMPAT_BWA_SAMPLES = [
    f"{base}-compat-bwa-mem"
    for base in COMPAT_BASE_SAMPLES
    if f"{base}-compat-bwa-mem" in CONFIG.samples
]


COMPAT_REAL_SAMPLES = [
    f"{base}-compat"
    for base in COMPAT_BASE_SAMPLES
    if f"{base}-compat" in CONFIG.samples
]

# Thread-invariance probe: one job, one host, both thread counts, self-compared.
# Keyed on the BASE sample (not the `-compat` sibling) because the rule adds
# `--compat=bwa-mem2` itself -- pointing it at the sibling would pass the flag
# twice. `c8g64` is the only queue with more vCPUs than the high rung needs.
COMPAT_INVARIANCE_SAMPLE = "wgs-5M"
COMPAT_INVARIANCE_ARCH = "c8g64"


def _compat_invariance_target() -> list:
    """Sentinel for the `-K` thread-invariance gate (see rules/compare.smk)."""
    return [
        f"runs/{FG_LABS_SHA}/compat-invariance/{COMPAT_INVARIANCE_SAMPLE}/"
        f"{COMPAT_INVARIANCE_ARCH}/report.txt"
    ]


def _fast_minibwa_targets() -> list:
    """minibwa wall-time probe for the fast comparison, cached by MINIBWA_SHA.

    Non-meth real samples run on every MINIBWA_ARCHS arch (reused from prior
    runs — only a MINIBWA_SHA bump re-aligns). The meth sample additionally
    runs minibwa in bisulfite mode (`--meth` → `.meth.mbw`) on m7i — the
    standard `minibwa` target omits this because MINIBWA_ARCHS excludes m7i,
    but minibwa's BS-seq path is real and the meth speed comparison wants it.
    """
    nonmeth_bases = [b for b in FAST_REAL_BASES if not _is_meth_sample(b)]
    targets = [
        f"minibwa/{MINIBWA_SHA}/{base}/{arch}/rep-{r}/aligned.minibwa.bam"
        for base in nonmeth_bases
        for arch in MINIBWA_ARCHS
        for r in range(1, REPS + 1)
    ]
    targets += [
        f"minibwa/{MINIBWA_SHA}/meth-twist-emseq-5M/m7i/rep-{r}/aligned.minibwa.bam"
        for r in range(1, REPS + 1)
    ]
    return targets


rule all:
    input:
        # fg-labs query alignments + concordance reports (baseline rep-1 is
        # pulled in as a dependency of compare_vs_baseline).
        [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/vs-baseline.json"
            for sample in SWEEP_SAMPLES
            for arch in _archs_for_sample(sample)
            for rep in range(1, REPS + 1)
        ],
        # ARM fg-labs alignments + ARM-vs-x86 concordance reports. Upstream
        # v2.2.1 has no ARM build, so we can't compare ARM directly to upstream;
        # vs-x86.json compares ARM fg-labs against fg-labs c6a (AVX2), which
        # itself has a vs-baseline.json against upstream. Transitively that
        # gives us ARM correctness. Meth excluded: ARM .4xlarge has 32 GB and
        # can't hold the doubled-meth FMI + packed ref.
        [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/vs-x86.json"
            for sample in SWEEP_SAMPLES
            if not _is_meth_sample(sample)
            for arch in ARM_ARCHS
            for rep in range(1, REPS + 1)
        ],
        [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/benchmarks/meta.json"
            for sample in SWEEP_SAMPLES
            if not _is_meth_sample(sample)
            for arch in ARM_ARCHS
            for rep in range(1, REPS + 1)
        ],
        # Baseline reps 2..REPS_BASELINE exist for timing only (all reps are
        # byte-identical since bwa-mem2 is deterministic). Listing them here
        # forces them to be materialized by `rule all`.
        [
            f"baseline/bwa-mem2-{CONFIG.upstream_tag}/{sample}/{arch}/rep-{rep}/aligned.bam"
            for sample in SWEEP_SAMPLES
            for arch in _archs_for_sample(sample)
            for rep in range(1, REPS_BASELINE + 1)
        ],
        # vs-golden (Gate #2): only when a previous-release golden is pinned,
        # never against itself, and only for samples the golden contains (see
        # GOLDEN_SAMPLES — a golden predating a sample has no BAM to compare to).
        [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/vs-golden.json"
            for sample in SWEEP_SAMPLES
            for arch in _archs_for_sample(sample)
            for rep in range(1, REPS + 1)
            if GOLDEN_REF_SHA and GOLDEN_REF_SHA != FG_LABS_SHA and sample in GOLDEN_SAMPLES
        ]
        + [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/vs-golden.json"
            for sample in SWEEP_SAMPLES
            if not _is_meth_sample(sample)
            for arch in ARM_ARCHS
            for rep in range(1, REPS + 1)
            if GOLDEN_REF_SHA and GOLDEN_REF_SHA != FG_LABS_SHA and sample in GOLDEN_SAMPLES
        ],


def _thread_scaling_target() -> str:
    """The thread-scaling ladder's single output (see rules/scaling.smk).

    Sample and arch come from `thread_scaling` in config/defaults.yaml rather
    than the run's --config samples/archs: the ladder is a fixed, gated
    measurement on one pinned low-noise host, not part of the cross-arch sweep.
    """
    ts = CONFIG.thread_scaling
    return f"scaling/{FG_LABS_SHA}/{ts.sample}/{ts.arch}/scaling.tsv"


rule bless_release:
    """Full candidate-release validation matrix — run to bless a fg-labs release.

    The union of three otherwise-separate targets, deduped by Snakemake:
      - `all`      — default-arm speed + upstream/x86 concordance across arches
                     (the regression sweep; deliberately excludes --fast/truth).
      - `fast`     — the `--fast` preset on every real dataset (incl. --fast
                     --meth on m7i): fast-vs-default concordance + timing + the
                     fast sim-accuracy arms + minibwa wall-time.
      - `accuracy` — holodeck truth-graded placement / MAPQ / variant / meth-corr
                     over the full sim datasets.

    Deliberately a SEPARATE aggregator rather than folding these into `all`:
    `all` is the cross-SHA regression baseline (`bench regression` diffs this
    run's `all` outputs against the pinned golden's), so its target set must stay
    byte-for-byte stable. `bless_release` layers the release-validation extras on
    top without perturbing that invariant. The default-arm targets shared with
    `all` resolve to the same output paths and are computed once.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- bless_release
    """
    input:
        rules.all.input,
        _fast_speed_targets(),
        _fast_accuracy_targets(),
        _fast_minibwa_targets(),
        _accuracy_targets(FULL_SIM_SAMPLES, REPS),
        _thread_scaling_target(),
        _compat_targets(COMPAT_REAL_SAMPLES, REPS),
        _compat_invariance_target(),


rule compat:
    """`--compat=bwa-mem2` byte-identity against upstream, every real dataset
    on every arch (fg-labs/bwa-mem3#277).

    Answers the question the sweep's `vs_baseline` cannot: is bwa-mem3's output
    byte-identical to bwa-mem2's, or merely identical once MQ/HN are excused?
    Under `--compat` those two tags are suppressed on both sides, so the ignore
    list is empty and any divergence — placement OR tag — counts against the
    score. A passing run is a 100% byte-identity claim.

    Runs on ARM as well as x86, which is the coverage that matters most: the
    open phantom-XS defect (fg-labs/bwa-mem3#290) is specific to the NEON and
    AVX-512BW 8-bit kswv kernels, and no compat check has ever run there.

    Included in `bless_release`. Reuses each base sample's baseline BAM, so on
    top of a completed `all` it costs only the compat alignments themselves.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- compat
    """
    input:
        _compat_targets(COMPAT_REAL_SAMPLES, REPS),
        _compat_invariance_target(),


rule compat_smoke:
    """Cheap wiring check for the compat pipeline before the full `compat` run.

    smoke-1M on the x86 baseline arch and on the core ARM arch at 1 rep — enough
    to prove the flag reaches the aligner, the strict (empty) ignore list is
    applied, and the ARM-to-x86 baseline fallback resolves.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- compat_smoke
    """
    input:
        f"runs/{FG_LABS_SHA}/smoke-1M-compat/c6a/rep-1/compare/vs-baseline.json",
        f"runs/{FG_LABS_SHA}/smoke-1M-compat/c8g/rep-1/compare/vs-baseline.json",
        # The fgumi identity gate on both an x86 and an ARM arch — the ARM cell
        # also exercises the x86-baseline fallback.
        f"runs/{FG_LABS_SHA}/smoke-1M-compat/c6a/rep-1/compare/compat-identity.txt",
        f"runs/{FG_LABS_SHA}/smoke-1M-compat/c8g/rep-1/compare/compat-identity.txt",


rule compat_bwa_smoke:
    """Cheap wiring check for the `--compat=bwa-mem` arm against lh3/bwa.

    The cheap way in: bwa needs its own index format and is materially slower
    than bwa-mem2, so the cost of a misconfiguration is paid on smoke-1M rather
    than on the full `compat_bwa` matrix. Run this first after any change to the
    arm's wiring, its index staging, or the `bwa_version` pin.

    Still outside `rule all` and `bless_release`, as is `compat_bwa` itself --
    see that rule for why the arm has not been folded into the release gate.

    Both arches are load-bearing, and for different reasons than the bwa-mem2
    smoke. c6a proves the arm at all. c8g proves the thing the bwa-mem2 arm
    structurally cannot: bwa builds on ARM (NEON since 0.7.18) while upstream
    bwa-mem2 does not, so this compares an ARM bwa-mem3 against an ARM bwa
    DIRECTLY instead of inferring it through x86. See align_bwa.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- compat_bwa_smoke
    """
    input:
        f"runs/{FG_LABS_SHA}/smoke-1M-compat-bwa-mem/c6a/rep-1/compare/bwa-identity.txt",
        f"runs/{FG_LABS_SHA}/smoke-1M-compat-bwa-mem/c8g/rep-1/compare/bwa-identity.txt",


rule compat_alt:
    """ALT-aware compat arms: both targets, with the `.alt` sidecar staged.

    The one configuration this harness has never run. Every other cell has
    ALT-awareness OFF, so `bns->anns[].is_alt` is never set and the ALT-specific
    primary selection, MAPQ adjustment, `pa:f:` tag and `-h INT,INT` alt cap are
    all dead code from the benchmark's point of view. Staging the sidecar marks
    3,171 of hg38's 3,366 contigs ALT, which is a different alignment problem
    rather than a marginal toggle -- and the one two upstream divergence reports
    (bwa-mem2#227, #61) are about.

    Both targets are requested against their own upstream: `-compat` vs the
    bwa-mem2 baseline (via `compat-identity.txt`) and `-compat-bwa-mem` vs the
    bwa arm (via `bwa-identity.txt`). The `wgs-5M-alt` base is pulled in
    implicitly -- `compare_vs_baseline` aliases both siblings onto it, so its
    ALT-aware bwa-mem2 baseline is built once and shared.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- compat_alt
    """
    input:
        [
            f"runs/{FG_LABS_SHA}/wgs-5M-alt-compat/{arch}/rep-1/compare/compat-identity.txt"
            for arch in ARCHS
        ],
        [
            f"runs/{FG_LABS_SHA}/wgs-5M-alt-compat-bwa-mem/{arch}/rep-1/compare/bwa-identity.txt"
            for arch in ARCHS
        ],


rule compat_bwa:
    """`--compat=bwa-mem` byte-identity against lh3/bwa, every real dataset on
    every arch.

    The bwa-side counterpart to `rule compat`. Answers a question no other
    target can: bwa-mem2 v2.2.1 is frozen at bwa 0.7.17, so the whole existing
    matrix says nothing about parity with the bwa people actually install today.

    Kept OUT of `bless_release` for now. The bwa arm is new and its cache is
    keyed on `bwa_version`, so the first run pays for every cell while later
    runs are free -- folding it into the release gate before it has a track
    record would make a bless fail on an arm nobody has watched yet. Promote it
    once this target has run clean across a release cycle.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- compat_bwa
    """
    input:
        _compat_bwa_targets(COMPAT_BWA_SAMPLES, REPS),


rule thread_scaling:
    """Thread-scaling ladder on the pinned low-noise host (see rules/scaling.smk).

    Runs `thread_scaling.sample` at every thread count in `thread_scaling.ladder`
    inside ONE Batch job on ONE instance, so strong-scaling efficiency is measured
    on fixed hardware. Included in `bless_release` — thread efficiency is gated
    release-over-release and is not allowed to regress.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- thread_scaling
    """
    input:
        _thread_scaling_target(),


rule baseline_all:
    """Run baseline (upstream bwa-mem2) for every sample × baseline-arch × rep.

    Arm archs are excluded: upstream v2.2.1 has no ARM support. Highlighting
    that gap is one of the benchmark's points — fg-labs runs on arm, upstream
    does not.

    Meth samples only run on m7i (needs >46 GB RSS).
    """
    input:
        [
            f"baseline/bwa-mem2-{CONFIG.upstream_tag}/{sample}/{arch}/rep-{rep}/aligned.bam"
            for sample in CONFIG.samples
            if not CONFIG.samples[sample].truth
            and not _is_fast_sample(sample)
            # Compat siblings are scored against their BASE sample's baseline
            # (see `_baseline_sample` in rules/compare.smk), so giving them their
            # own would realign identical input under a second name.
            and not _is_compat_sample(sample)
            for arch in _archs_for_sample(sample)
            for rep in range(1, REPS_BASELINE + 1)
        ]


rule smoke:
    """End-to-end AWS smoke across every benchmarked arch.

    For each arch in CONFIG.full_archs:
      - run fg-labs bwa-mem3 on smoke-1M — exercises that
        the arch-specific SIMD build (NEON / AVX2 / AVX-512 / etc.) works on a
        real worker of that instance family.
    Additionally, for every baseline-supported arch (x86):
      - also run the upstream baseline + compare-bams — exercises the full
        correctness path and produces a vs-baseline.json concordance number.

    Arm archs get a vs-x86.json compare against fg-labs c6a (AVX2) — since
    upstream v2.2.1 has no ARM build, ARM correctness is established
    transitively (ARM == c6a fg-labs, c6a fg-labs == upstream).

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- smoke
    """
    input:
        [
            f"runs/{FG_LABS_SHA}/smoke-1M/{arch}/rep-{rep}/aligned.bam"
            for arch in CONFIG.full_archs
            for rep in range(1, REPS + 1)
        ],
        [
            f"runs/{FG_LABS_SHA}/smoke-1M/{arch}/rep-{rep}/compare/vs-x86.json"
            for arch in CONFIG.full_archs
            if CONFIG.archs[arch].platform == "linux/arm64"
            for rep in range(1, REPS + 1)
        ],
        [
            f"runs/{FG_LABS_SHA}/smoke-1M/{arch}/rep-{rep}/compare/vs-baseline.json"
            for arch in CONFIG.full_archs
            if CONFIG.archs[arch].platform == "linux/amd64"
            for rep in range(1, REPS + 1)
        ],


rule smoke_meth:
    """Bisulfite-specific smoke. Runs the full meth pipeline end-to-end on a
    ~10K-pair sample — exercises (a) the hg38-meth doubled c2t reference,
    (b) the bwameth.py → bwa-mem2 (upstream launcher → bwa-mem2.avx*)
    dispatch chain, (c) the fg-labs `--meth` path (single binary with
    in-process SIMD dispatch since PR #83), and (d) the m7i arch queue
    (m7i.4xlarge, 64 GB) which is where real meth samples also run.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- smoke_meth
    """
    input:
        "runs/{sha}/smoke-meth/m7i/rep-1/aligned.bam".format(sha=FG_LABS_SHA),
        "runs/{sha}/smoke-meth/m7i/rep-1/compare/vs-baseline.json".format(sha=FG_LABS_SHA),


rule minibwa_smoke:
    """End-to-end AWS smoke for the minibwa pipeline. Runs lh3/minibwa on
    smoke-1M across every non-meth arch (1 rep each). Exercises the full
    minibwa path — vendored-submodule build, S3 `.l2b`/`.mbw` index staging,
    index prewarm, tricorder timing, `samtools view -b` — without paying for
    the 5M-pair workload. The smoke also validates that the S3-resident
    minibwa index is format-compatible with the pinned `MINIBWA_SHA`.

    Outputs are cached under `minibwa/<MINIBWA_SHA>/...` (keyed on the minibwa
    SHA, not the fg-labs SHA), so this only re-runs when `MINIBWA_SHA` changes.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            -- minibwa_smoke
    """
    input:
        [
            f"minibwa/{MINIBWA_SHA}/smoke-1M/{a}/rep-1/aligned.minibwa.bam"
            for a in MINIBWA_ARCHS
        ],


rule minibwa:
    """Opt-in target: run lh3/minibwa as a runtime probe alongside the
    bwa-mem2 benchmark surface, across every non-meth arch.

    Sample × arch × rep matrix:
      - smoke-1M, 1 rep, all non-meth archs (build / sanity)
      - every non-meth bench sample, REPS each, all non-meth archs: wgs-5M +
        wes-5M (standard PE), panel-twist-5M (hybrid panel), hic-1M (Hi-C PE),
        and sbx-1M (Roche SBX single-end). Together these give minibwa a row
        against bwa-mem3/bwa-mem2 on every dataset it can align. The meth
        samples are excluded — minibwa has no bisulfite path.

    Outputs are cached under `minibwa/<MINIBWA_SHA>/<sample>/<arch>/rep-<r>/`
    (aligned.minibwa.bam + benchmarks/timing.minibwa.tsv +
    benchmarks/minibwa.stderr.log), keyed on the minibwa SHA so a re-run for a
    new fg-labs SHA reuses them and only a `MINIBWA_SHA` bump re-aligns. No
    compare-bams runs against these BAMs (wall time only); `cli collect`
    ingests the timing TSVs into benchmark.db as the `minibwa` tool dimension.

    The x86 archs run minibwa's SSE4.2 build while bwa-mem3 runs AVX2/AVX-512,
    so x86 rows include an ISA-maturity gap (minibwa AVX is upstream WIP); the
    NEON archs (c7g/c8g) are the clean same-ISA algorithmic comparison.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            -- minibwa
    """
    input:
        [
            f"minibwa/{MINIBWA_SHA}/smoke-1M/{a}/rep-1/aligned.minibwa.bam"
            for a in MINIBWA_ARCHS
        ],
        [
            f"minibwa/{MINIBWA_SHA}/{sample}/{a}/rep-{r}/aligned.minibwa.bam"
            # Every non-meth bench sample minibwa can align: the standard
            # paired-end pair (wgs/wes), the hybrid panel, Hi-C PE, and Roche
            # SBX (single-end — handled by `align_minibwa` via `_query_fastqs`).
            # minibwa has no bisulfite path, so the meth samples are excluded.
            for sample in ("wgs-5M", "wes-5M", "panel-twist-5M", "hic-1M", "sbx-1M")
            for a in MINIBWA_ARCHS
            for r in range(1, REPS + 1)
        ],


rule accuracy:
    """Truth-based alignment-accuracy benchmark over the full sim datasets.

    Grades each aligner arm's BAM against holodeck simulation truth (placement +
    MAPQ calibration, per-read variant representation, methylation-level
    correlation) — no variant caller, no methylation extractor, so the numbers
    isolate the aligner. Per dataset the arms are:
      - non-meth: bwa-mem3 (fg-labs) · minibwa · upstream bwa-mem2
      - meth:     D3 collapsed · D3 genomic (its own `*-genomic` sample) · bwameth

    Accuracy is ~arch-invariant, so each chemistry is pinned to a single arch
    (non-meth → c6a, meth → m7i) rather than swept across SIMD tiers. Outputs
    land at runs/<sha>/<sample>/<arch>/rep-<r>/eval/<tool>.{eval.txt,variants.tsv,
    meth.tsv}; `cli collect` ingests them into the `accuracy` table.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- accuracy
    """
    input:
        _accuracy_targets(FULL_SIM_SAMPLES, REPS)


rule accuracy_smoke:
    """Fast wiring check for the accuracy pipeline on chr22-slice sim datasets.

    Exercises the full `holodeck eval` matrix (all arms, all three axes) on tiny
    chr22-slice datasets at 1 rep — cheap end-to-end validation before paying
    for the full-hg38 `accuracy` run.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- accuracy_smoke
    """
    input:
        _accuracy_targets(SMOKE_SIM_SAMPLES, 1)


rule fast:
    """`--fast` preset benchmark (fg-labs/bwa-mem3 PR #189) — opt-in.

    Runs each FAST_REAL_BASES sample with AND without `--fast` at one fg-labs
    SHA (so default-vs-fast isolates the preset on a byte-identical binary),
    plus the FAST_SIM_BASES truth-based accuracy arms. Produces:
      - wall + peak RSS per arm (tricord timing.tsv),
      - upstream/bwameth concordance for the default arm (vs-baseline / vs-x86),
      - fast-vs-default concordance with MAPQ stratification (vs-default.json),
      - holodeck-graded sensitivity/specificity for the sim siblings.
    minibwa is reused from its MINIBWA_SHA cache (nothing re-aligns there).

    Build the image at PR #189's head SHA first, then submit; the default and
    fast arms are produced together by this one target.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<#189-head-sha> -- fast
    """
    input:
        _fast_speed_targets(),
        _fast_accuracy_targets(),
        _fast_minibwa_targets(),


rule fast_meth:
    """Meth-only slice of `fast` — re-verify just the `--fast --meth` arm (e.g.
    after changing its reseed level) without re-running the SHA-stable non-meth
    matrix. Meth runs only on m7i. Produces, for the meth sample and the two
    meth sim datasets:
      - default vs bwameth concordance + fast vs default concordance,
      - truth-graded placement for default + fast (fg-labs) arms,
      - minibwa meth speed (cached by MINIBWA_SHA — reused, not re-aligned).

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> archs=m7i -- fast_meth
    """
    input:
        [
            f"runs/{FG_LABS_SHA}/meth-twist-emseq-5M/m7i/rep-{r}/compare/vs-baseline.json"
            for r in range(1, REPS + 1)
        ],
        [
            f"runs/{FG_LABS_SHA}/meth-twist-emseq-5M-fast/m7i/rep-{r}/compare/vs-default.json"
            for r in range(1, REPS + 1)
        ],
        _accuracy_targets(["sim-meth-place", "sim-meth-vars"], REPS),
        _accuracy_targets(["sim-meth-place-fast", "sim-meth-vars-fast"], REPS),
        [
            f"minibwa/{MINIBWA_SHA}/meth-twist-emseq-5M/m7i/rep-{r}/aligned.minibwa.bam"
            for r in range(1, REPS + 1)
        ],


rule fast_smoke:
    """End-to-end AWS smoke for the `--fast` preset pipeline — cheap wiring
    validation before the full `fast` run. Exercises, at 1 rep:
      - `--fast` align (smoke-1M-fast) + fast-vs-default + fast-vs-upstream on
        c6a (x86 baseline), plus fast-vs-default + transitive vs-x86 on c8g,
      - `--meth --fast` align (smoke-meth-fast) + compares on m7i,
      - the accuracy fast arm (sim-smoke-vars-fast grades vs holodeck truth) on
        c6a.
    Submit with the matching archs (c6a,c8g,m7i) and build the image at PR
    #189's head SHA first.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> archs=c6a,c8g,m7i -- fast_smoke
    """
    input:
        # Non-meth: default + fast vs upstream (c6a); fast vs default (c6a, c8g).
        f"runs/{FG_LABS_SHA}/smoke-1M/c6a/rep-1/compare/vs-baseline.json",
        f"runs/{FG_LABS_SHA}/smoke-1M-fast/c6a/rep-1/compare/vs-baseline.json",
        f"runs/{FG_LABS_SHA}/smoke-1M-fast/c6a/rep-1/compare/vs-default.json",
        f"runs/{FG_LABS_SHA}/smoke-1M-fast/c8g/rep-1/compare/vs-default.json",
        f"runs/{FG_LABS_SHA}/smoke-1M-fast/c8g/rep-1/compare/vs-x86.json",
        # Meth: default + fast vs bwameth (m7i); fast vs default (m7i).
        f"runs/{FG_LABS_SHA}/smoke-meth/m7i/rep-1/compare/vs-baseline.json",
        f"runs/{FG_LABS_SHA}/smoke-meth-fast/m7i/rep-1/compare/vs-baseline.json",
        f"runs/{FG_LABS_SHA}/smoke-meth-fast/m7i/rep-1/compare/vs-default.json",
        # Accuracy: the fast arm grades against truth (chr22-slice).
        f"runs/{FG_LABS_SHA}/sim-smoke-vars-fast/c6a/rep-1/eval/fg-labs.variants.tsv",
