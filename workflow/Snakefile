"""bwa-mem3-bench Snakemake workflow.

AWS smoke (one baseline job + one fg-labs job + compare, via AWS Batch):
    snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
        --config fg_labs_sha=<sha> -- smoke

Full AWS run:
    snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
        --config fg_labs_sha=<sha> archs=c8g,c6a,c7i reps=1

Baseline bless (one-time per upstream version):
    snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
        --config upstream_tag=v2.2.1 reps=5 -- baseline_all
"""

import sys
from pathlib import Path

# Make the Python package importable from the repo root.
sys.path.insert(0, str(Path(workflow.basedir).parent))

from bwa_mem3_bench.workflow_config import load_config


CONFIG = load_config(Path(workflow.basedir).parent / "config")

# -- Parameters from --config
FG_LABS_SHA = config.get("fg_labs_sha", "MISSING")
ARCHS = config.get("archs", CONFIG.core_arch).split(",")
SAMPLES = config.get("samples", ",".join(CONFIG.samples.keys())).split(",")
REPS = int(config.get("reps", CONFIG.reps_default))
REPS_BASELINE = int(config.get("reps_baseline", CONFIG.reps_baseline))
# Pinned previous-release SHA for the vs-golden (Gate #2) comparison. Empty
# disables vs-golden — `compare_vs_golden` only fires when this is set, and it
# reads golden/fg-labs-<GOLDEN_REF_SHA>/ (not the run's own SHA).
GOLDEN_REF_SHA = config.get("golden_ref_sha", "")
BASELINE_ONLY = str(config.get("baseline_only", "false")).lower() == "true"
IMAGE = config.get("image_tag", f"bwa-mem3-bench:{FG_LABS_SHA}")

# ---------------------------------------------------------------------------
# Per-rule image selection.
#
# Each Batch worker pulls a different ECR image based on its arch:
#   - portable (c7g, c8g): the bare `<sha>` tag — multi-arch manifest list
#     (linux/amd64 + linux/arm64), `BASELINE_ARCH=avx2` x86 build.
#   - avx2 (c6a):     `<sha>-avx2` (explicit, same content as portable today).
#   - avx512bw-locked (c7a, c7i, m7i): `<sha>-avx512bw` — linux/amd64 only,
#     non-kernel TUs compiled at AVX-512BW for ~10-15% better hot-path perf
#     on AVX-512 hosts (fg-labs/bwa-mem3 PR #84). Crashes on AVX2-only hosts.
#
# The mapping is driven by `arch.baseline_arch` in `config/archs.yaml`. Each
# rule's `resources.container_image` lambda calls `image_for_arch` below;
# our snakemake-executor-plugin-aws-batch fork reads the resource and uses
# it as the SubmitJob job-def's `containerProperties.image`. When unset
# (e.g. future rules that don't care about arch), the profile's
# `container-image` falls back. Build-side: `cli build --baseline-arch
# <tier>` produces the matching ECR tag.
# ---------------------------------------------------------------------------

from bwa_mem3_bench import aws_config as _aws_config
from bwa_mem3_bench import minibwa_sha as _minibwa_sha
from bwa_mem3_bench.golden import golden_backed_samples

_AWS = _aws_config.load()
_ECR_REPO_URI = _AWS.ecr_repo_uri

# Samples the pinned golden actually contains. A golden blessed before a sample
# existed (e.g. the v0.2.2 golden predates hic-1M / sbx-1M) lacks that sample's
# BAM, so requesting vs-golden for it would make `rule all` unsatisfiable. We
# scope vs-golden to this set. Empty unless a golden is pinned (no S3 call then).
GOLDEN_SAMPLES = (
    golden_backed_samples(_AWS.bucket, GOLDEN_REF_SHA)
    if GOLDEN_REF_SHA and GOLDEN_REF_SHA != FG_LABS_SHA
    else frozenset()
)


def image_for_arch(arch_name: str) -> str:
    """Fully-qualified ECR image URI for a worker on `arch_name`."""
    return CONFIG.archs[arch_name].image_uri(
        ecr_repo_uri=_ECR_REPO_URI,
        fg_labs_sha=FG_LABS_SHA,
    )


# Upstream bwa-mem2 v2.2.1 only supports x86. Anything that needs
# `bwa-mem2.upstream` (align_baseline, compare_vs_baseline) is restricted to
# baseline-supported archs; arm archs get fg-labs alignments only (and
# eventually compare_vs_golden once a golden exists).
BASELINE_ARCHS = [a for a in ARCHS if CONFIG.archs[a].platform == "linux/amd64"]
ARM_ARCHS = [a for a in ARCHS if CONFIG.archs[a].platform == "linux/arm64"]
# Archs the minibwa probe runs on (private/minibwa-bench branch only). Drops
# m7i, which exists in full_archs only for meth-FMI memory headroom — minibwa
# has no meth path. Every other arch in the user's selection is kept so
# per-SIMD differences stay visible.
MINIBWA_ARCHS = [a for a in ARCHS if a != "m7i"]
# Pinned lh3/minibwa SHA (canonical source: docker/build-arg-defaults.env).
# minibwa cache outputs live under `minibwa/<MINIBWA_SHA>/...`, so they are
# only re-aligned when the vendored submodule (and this SHA) is bumped.
MINIBWA_SHA = _minibwa_sha()

RUNS_DIR = Path(f"runs/{FG_LABS_SHA}")

wildcard_constraints:
    sample      = "[A-Za-z0-9_-]+",
    arch        = "[a-z0-9]+",
    rep         = r"\d+",
    minibwa_sha = "[0-9a-f]+",
    tool        = "fg-labs|baseline|minibwa"

include: "rules/align.smk"
include: "rules/compare.smk"
include: "rules/benchmark.smk"
include: "rules/align_minibwa.smk"
include: "rules/eval.smk"


# Aggregator targets have no shell body, so they always run on the coordinator.
# `emit_meta` is a tiny JSON write — no point burning a c8g.4xlarge spin-up for it.
localrules:
    all,
    baseline_all,
    smoke,
    smoke_meth,
    minibwa,
    minibwa_smoke,
    accuracy,
    accuracy_smoke,
    emit_meta,


def _is_meth_sample(sample_name: str) -> bool:
    # Single meth predicate — delegates to Sample.is_meth (config-validated to
    # agree with the sample's reference; see Sample.__post_init__).
    return CONFIG.samples[sample_name].is_meth


def _archs_for_sample(sample_name: str) -> list:
    """Meth samples run only on m7i (needs ~50 GB container RAM for the doubled
    meth FMI, doesn't fit on c7i.4xlarge's 32 GB host); non-meth samples run
    across all baseline-supported x86 archs in the user's selection so we get
    per-SIMD perf numbers."""
    if _is_meth_sample(sample_name):
        return [a for a in BASELINE_ARCHS if a == "m7i"]
    return BASELINE_ARCHS


# Samples in the speed/concordance sweep (`rule all`, `baseline_all`). Truth
# (sim-*) samples are excluded — they have no upstream-concordance question and
# are driven by the `accuracy` / `accuracy_smoke` targets instead (eval.smk).
SWEEP_SAMPLES = [s for s in SAMPLES if not CONFIG.samples[s].truth]


# ---------------------------------------------------------------------------
# Truth-based accuracy targets (holodeck eval). Accuracy is a property of the
# aligner build and is ~arch-invariant, so — unlike the timing sweep — we do
# NOT stratify by arch: each chemistry is pinned to a single arch. Non-meth runs
# on the cheapest baseline-supported x86 (c6a); meth runs on m7i, the only arch
# with RAM for the doubled meth FMI.
# ---------------------------------------------------------------------------
_ACCURACY_ARCH_NONMETH = "c6a"
_ACCURACY_ARCH_METH = "m7i"

# Sourced from SAMPLES (not CONFIG.samples) so `--config samples=` scopes the
# accuracy run too, symmetric with SWEEP_SAMPLES. SAMPLES defaults to every
# config sample, so an unscoped `accuracy` run still covers all sim datasets.
SIM_SAMPLES = [s for s in SAMPLES if CONFIG.samples[s].truth]
SMOKE_SIM_SAMPLES = [s for s in SIM_SAMPLES if s.startswith("sim-smoke-")]
FULL_SIM_SAMPLES = [s for s in SIM_SAMPLES if not s.startswith("sim-smoke-")]


def _accuracy_arch(sample_name: str) -> str:
    return _ACCURACY_ARCH_METH if _is_meth_sample(sample_name) else _ACCURACY_ARCH_NONMETH


def _accuracy_targets(samples: list, reps: int) -> list:
    """Eval-output sentinels (`.variants.tsv`) for the accuracy matrix.

    Per dataset the arms are:
      - fg-labs: every sim sample (the genomic D3 arm is its own sample sharing
        truth + FASTQs with its collapsed sibling).
      - baseline: the primary (non-genomic) arm only — bwa-mem2 upstream for
        non-meth, bwameth for meth.
      - minibwa: non-meth primary arms only (minibwa has no --meth path).
    Requesting one of the eval rule's three outputs pulls the whole rule.
    """
    targets = []
    for sample in samples:
        arch = _accuracy_arch(sample)
        meth = _is_meth_sample(sample)
        genomic = "genomic" in CONFIG.samples[sample].fg_labs_flags
        for rep in range(1, reps + 1):
            base = f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/eval"
            targets.append(f"{base}/fg-labs.variants.tsv")
            if not genomic:
                targets.append(f"{base}/baseline.variants.tsv")
                if not meth:
                    targets.append(f"{base}/minibwa.variants.tsv")
    return targets


rule all:
    input:
        # fg-labs query alignments + concordance reports (baseline rep-1 is
        # pulled in as a dependency of compare_vs_baseline).
        [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/vs-baseline.json"
            for sample in SWEEP_SAMPLES
            for arch in _archs_for_sample(sample)
            for rep in range(1, REPS + 1)
        ],
        # ARM fg-labs alignments + ARM-vs-x86 concordance reports. Upstream
        # v2.2.1 has no ARM build, so we can't compare ARM directly to upstream;
        # vs-x86.json compares ARM fg-labs against fg-labs c6a (AVX2), which
        # itself has a vs-baseline.json against upstream. Transitively that
        # gives us ARM correctness. Meth excluded: ARM .4xlarge has 32 GB and
        # can't hold the doubled-meth FMI + packed ref.
        [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/vs-x86.json"
            for sample in SWEEP_SAMPLES
            if not _is_meth_sample(sample)
            for arch in ARM_ARCHS
            for rep in range(1, REPS + 1)
        ],
        [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/benchmarks/meta.json"
            for sample in SWEEP_SAMPLES
            if not _is_meth_sample(sample)
            for arch in ARM_ARCHS
            for rep in range(1, REPS + 1)
        ],
        # Baseline reps 2..REPS_BASELINE exist for timing only (all reps are
        # byte-identical since bwa-mem2 is deterministic). Listing them here
        # forces them to be materialized by `rule all`.
        [
            f"baseline/bwa-mem2-{CONFIG.upstream_tag}/{sample}/{arch}/rep-{rep}/aligned.bam"
            for sample in SWEEP_SAMPLES
            for arch in _archs_for_sample(sample)
            for rep in range(1, REPS_BASELINE + 1)
        ],
        # vs-golden (Gate #2): only when a previous-release golden is pinned,
        # never against itself, and only for samples the golden contains (see
        # GOLDEN_SAMPLES — a golden predating a sample has no BAM to compare to).
        [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/vs-golden.json"
            for sample in SWEEP_SAMPLES
            for arch in _archs_for_sample(sample)
            for rep in range(1, REPS + 1)
            if GOLDEN_REF_SHA and GOLDEN_REF_SHA != FG_LABS_SHA and sample in GOLDEN_SAMPLES
        ]
        + [
            f"runs/{FG_LABS_SHA}/{sample}/{arch}/rep-{rep}/compare/vs-golden.json"
            for sample in SWEEP_SAMPLES
            if not _is_meth_sample(sample)
            for arch in ARM_ARCHS
            for rep in range(1, REPS + 1)
            if GOLDEN_REF_SHA and GOLDEN_REF_SHA != FG_LABS_SHA and sample in GOLDEN_SAMPLES
        ],


rule baseline_all:
    """Run baseline (upstream bwa-mem2) for every sample × baseline-arch × rep.

    Arm archs are excluded: upstream v2.2.1 has no ARM support. Highlighting
    that gap is one of the benchmark's points — fg-labs runs on arm, upstream
    does not.

    Meth samples only run on m7i (needs >46 GB RSS).
    """
    input:
        [
            f"baseline/bwa-mem2-{CONFIG.upstream_tag}/{sample}/{arch}/rep-{rep}/aligned.bam"
            for sample in CONFIG.samples
            if not CONFIG.samples[sample].truth
            for arch in _archs_for_sample(sample)
            for rep in range(1, REPS_BASELINE + 1)
        ]


rule smoke:
    """End-to-end AWS smoke across every benchmarked arch.

    For each arch in CONFIG.full_archs:
      - run fg-labs bwa-mem3 on smoke-1M — exercises that
        the arch-specific SIMD build (NEON / AVX2 / AVX-512 / etc.) works on a
        real worker of that instance family.
    Additionally, for every baseline-supported arch (x86):
      - also run the upstream baseline + compare-bams — exercises the full
        correctness path and produces a vs-baseline.json concordance number.

    Arm archs get a vs-x86.json compare against fg-labs c6a (AVX2) — since
    upstream v2.2.1 has no ARM build, ARM correctness is established
    transitively (ARM == c6a fg-labs, c6a fg-labs == upstream).

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- smoke
    """
    input:
        [
            f"runs/{FG_LABS_SHA}/smoke-1M/{arch}/rep-{rep}/aligned.bam"
            for arch in CONFIG.full_archs
            for rep in range(1, REPS + 1)
        ],
        [
            f"runs/{FG_LABS_SHA}/smoke-1M/{arch}/rep-{rep}/compare/vs-x86.json"
            for arch in CONFIG.full_archs
            if CONFIG.archs[arch].platform == "linux/arm64"
            for rep in range(1, REPS + 1)
        ],
        [
            f"runs/{FG_LABS_SHA}/smoke-1M/{arch}/rep-{rep}/compare/vs-baseline.json"
            for arch in CONFIG.full_archs
            if CONFIG.archs[arch].platform == "linux/amd64"
            for rep in range(1, REPS + 1)
        ],


rule smoke_meth:
    """Bisulfite-specific smoke. Runs the full meth pipeline end-to-end on a
    ~10K-pair sample — exercises (a) the hg38-meth doubled c2t reference,
    (b) the bwameth.py → bwa-mem2 (upstream launcher → bwa-mem2.avx*)
    dispatch chain, (c) the fg-labs `--meth` path (single binary with
    in-process SIMD dispatch since PR #83), and (d) the m7i arch queue
    (m7i.4xlarge, 64 GB) which is where real meth samples also run.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- smoke_meth
    """
    input:
        "runs/{sha}/smoke-meth/m7i/rep-1/aligned.bam".format(sha=FG_LABS_SHA),
        "runs/{sha}/smoke-meth/m7i/rep-1/compare/vs-baseline.json".format(sha=FG_LABS_SHA),


rule minibwa_smoke:
    """End-to-end AWS smoke for the minibwa pipeline. Runs lh3/minibwa on
    smoke-1M across every non-meth arch (1 rep each). Exercises the full
    minibwa path — vendored-submodule build, S3 `.l2b`/`.mbw` index staging,
    index prewarm, tricorder timing, `samtools view -b` — without paying for
    the 5M-pair workload. The smoke also validates that the S3-resident
    minibwa index is format-compatible with the pinned `MINIBWA_SHA`.

    Outputs are cached under `minibwa/<MINIBWA_SHA>/...` (keyed on the minibwa
    SHA, not the fg-labs SHA), so this only re-runs when `MINIBWA_SHA` changes.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            -- minibwa_smoke
    """
    input:
        [
            f"minibwa/{MINIBWA_SHA}/smoke-1M/{a}/rep-1/aligned.minibwa.bam"
            for a in MINIBWA_ARCHS
        ],


rule minibwa:
    """Opt-in target: run lh3/minibwa as a runtime probe alongside the
    bwa-mem2 benchmark surface, across every non-meth arch.

    Sample × arch × rep matrix:
      - smoke-1M, 1 rep, all non-meth archs (build / sanity)
      - every non-meth bench sample, REPS each, all non-meth archs: wgs-5M +
        wes-5M (standard PE), panel-twist-5M (hybrid panel), hic-1M (Hi-C PE),
        and sbx-1M (Roche SBX single-end). Together these give minibwa a row
        against bwa-mem3/bwa-mem2 on every dataset it can align. The meth
        samples are excluded — minibwa has no bisulfite path.

    Outputs are cached under `minibwa/<MINIBWA_SHA>/<sample>/<arch>/rep-<r>/`
    (aligned.minibwa.bam + benchmarks/timing.minibwa.tsv +
    benchmarks/minibwa.stderr.log), keyed on the minibwa SHA so a re-run for a
    new fg-labs SHA reuses them and only a `MINIBWA_SHA` bump re-aligns. No
    compare-bams runs against these BAMs (wall time only); `cli collect`
    ingests the timing TSVs into benchmark.db as the `minibwa` tool dimension.

    The x86 archs run minibwa's SSE4.2 build while bwa-mem3 runs AVX2/AVX-512,
    so x86 rows include an ISA-maturity gap (minibwa AVX is upstream WIP); the
    NEON archs (c7g/c8g) are the clean same-ISA algorithmic comparison.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            -- minibwa
    """
    input:
        [
            f"minibwa/{MINIBWA_SHA}/smoke-1M/{a}/rep-1/aligned.minibwa.bam"
            for a in MINIBWA_ARCHS
        ],
        [
            f"minibwa/{MINIBWA_SHA}/{sample}/{a}/rep-{r}/aligned.minibwa.bam"
            # Every non-meth bench sample minibwa can align: the standard
            # paired-end pair (wgs/wes), the hybrid panel, Hi-C PE, and Roche
            # SBX (single-end — handled by `align_minibwa` via `_query_fastqs`).
            # minibwa has no bisulfite path, so the meth samples are excluded.
            for sample in ("wgs-5M", "wes-5M", "panel-twist-5M", "hic-1M", "sbx-1M")
            for a in MINIBWA_ARCHS
            for r in range(1, REPS + 1)
        ],


rule accuracy:
    """Truth-based alignment-accuracy benchmark over the full sim datasets.

    Grades each aligner arm's BAM against holodeck simulation truth (placement +
    MAPQ calibration, per-read variant representation, methylation-level
    correlation) — no variant caller, no methylation extractor, so the numbers
    isolate the aligner. Per dataset the arms are:
      - non-meth: bwa-mem3 (fg-labs) · minibwa · upstream bwa-mem2
      - meth:     D3 collapsed · D3 genomic (its own `*-genomic` sample) · bwameth

    Accuracy is ~arch-invariant, so each chemistry is pinned to a single arch
    (non-meth → c6a, meth → m7i) rather than swept across SIMD tiers. Outputs
    land at runs/<sha>/<sample>/<arch>/rep-<r>/eval/<tool>.{eval.txt,variants.tsv,
    meth.tsv}; `cli collect` ingests them into the `accuracy` table.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- accuracy
    """
    input:
        _accuracy_targets(FULL_SIM_SAMPLES, REPS)


rule accuracy_smoke:
    """Fast wiring check for the accuracy pipeline on chr22-slice sim datasets.

    Exercises the full `holodeck eval` matrix (all arms, all three axes) on tiny
    chr22-slice datasets at 1 rep — cheap end-to-end validation before paying
    for the full-hg38 `accuracy` run.

    Usage:
        snakemake -s workflow/Snakefile --profile workflow/profiles/aws-batch \\
            --config fg_labs_sha=<sha> -- accuracy_smoke
    """
    input:
        _accuracy_targets(SMOKE_SIM_SAMPLES, 1)
