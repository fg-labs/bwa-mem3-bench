# Snakemake AWS Batch profile template — rendered to ./config.yaml by
#   pixi run render-profile
# (or `python -m bwa_mem3_bench.render_profile`). The rendered file is
# gitignored; placeholders below are substituted from cdk/outputs.json or
# env vars (BWA_MEM3_BENCH_S3_BUCKET, BWA_MEM3_BENCH_ECR_REPO, AWS_REGION).
# Optional: BWA_MEM3_BENCH_COST_CENTER adds a CostCenter Batch tag.
executor: aws-batch

# Each Batch job runs in this image. The image has bwa-mem2.{upstream,fg-labs},
# samtools, bwameth, compare-bams, awscli, and the bwa-mem3-bench python CLI
# pre-installed so shell commands in workflow/rules/*.smk execute directly.
# When running inside the coordinator job, override container-image via
#   --config image_tag=<sha>  (the coordinator-entrypoint.sh passes this through).
container-image: ${ECR_REPO_URI}:latest

# snakemake-executor-plugin-aws-batch required settings. The plugin takes a
# single --aws-batch-job-queue; we route by arch at the rule level via
# resources.batch_queue (which the executor reads and overrides this default).
aws-batch-region: ${AWS_REGION}
aws-batch-job-queue: bwa-mem3-bench-c8g
# The plugin's default attemptDurationSeconds is 300 s, which is shorter than
# even a 1M-read alignment's cold-start + S3 reference sync on a slow worker.
#
# THIS IS THE ONLY attemptDurationSeconds SOURCE. A per-rule `resources.runtime`
# (e.g. `align_thread_scaling`'s `runtime: 14400`) looks like an override but is
# NOT ONE: our forked snakemake-executor-plugin-aws-batch's batch_job_builder.py
# builds the SubmitJob timeout as `{"attemptDurationSeconds": self.settings.task_timeout}`
# unconditionally — it never reads `job.resources.runtime`. Confirmed the hard
# way: `align_thread_scaling`'s 4-hour ladder was killed at exactly 7200 s
# (`stoppedAt - startedAt` on the failed job matched this value to the second),
# not the rule's declared 14400 s. Same class of bug as the `threads`-clamping
# gotcha in CLAUDE.md -- a per-rule resource that LOOKS like it reaches the
# Batch job but doesn't, discoverable only from a real submitted job's actual
# timeout, never from --dry-run. Set this to the slowest single job in the
# whole DAG, not a typical one -- currently that is `align_thread_scaling`'s
# full 7-rung, 3-rep ladder. Guarded by tests/test_thread_packing.py::
# test_batch_profile_task_timeout_covers_every_rule_runtime, which fails if
# this value drops below any rule's declared `runtime`.
aws-batch-task-timeout: 14400
# aws-batch-job-role is intentionally omitted here. When running inside the
# coordinator Batch job the SNAKEMAKE_AWS_BATCH_JOB_ROLE env var (set by the
# job definition) provides the role ARN so no config-file change is needed
# between deploys.
aws-batch-tags:
  Project: bwa-mem3-bench
${COST_CENTER_LINE}
# Snakemake 8+ requires a default storage provider for remote executors so
# inputs/outputs are staged to/from S3 rather than assumed on a shared FS.
default-storage-provider: s3
default-storage-prefix: s3://${S3_BUCKET}
storage-s3-region: ${AWS_REGION}

default-resources:
  mem_mb: 28000
  # Intentionally DIFFERENT from aws-batch-task-timeout above, and that's fine:
  # this `runtime` (like every per-rule `resources.runtime`) is dead for the
  # aws-batch executor -- see aws-batch-task-timeout's comment above. It's
  # snakemake's own internal default for a rule that declares no `runtime` of
  # its own, used for in-DAG reporting/estimation only; it never reaches AWS.
  # aws-batch-task-timeout alone governs the actual submitted timeout, for
  # every job uniformly, regardless of what any `runtime` says.
  runtime: 7200
# Max concurrent Batch jobs AND, in remote-executor mode, the ceiling snakemake
# clamps every rule's `threads` to. That second role is the binding one here:
# `align_thread_scaling` requests `threads: 64` to reserve a whole c8g.16xlarge,
# and with `jobs: 50` snakemake silently handed it `threads: 50` — a 50-vCPU
# reservation that only keeps the host exclusive by arithmetic accident
# (2 x 50 > 64). Lowering this below the ladder's max thread count would let two
# ladder jobs share a host and corrupt every point on the curve, so it must stay
# >= `thread_scaling.ladder`'s largest rung. tests/test_thread_packing.py pins
# that invariant.
jobs: 64
max-jobs-per-second: 5
latency-wait: 60
use-conda: false
use-singularity: false
retries: 3
keep-going: true
printshellcmds: true
rerun-incomplete: true
