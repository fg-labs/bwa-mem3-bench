# Defaults sourced by pixi build-docker task.
UPSTREAM_REPO=https://github.com/bwa-mem2/bwa-mem2
UPSTREAM_TAG=v2.2.1
FG_LABS_REPO=https://github.com/fg-labs/bwa-mem3
# FG_LABS_SHA is required per-build; no default.
BWAMETH_VERSION=0.2.7
SAMTOOLS_VERSION=1.23.1
BWA_VERSION=0.7.19
# minibwa is vendored as a git submodule at vendor/minibwa (lh3/minibwa is
# private — can't clone at build time). MINIBWA_SHA is recorded for image
# label only; the actual source pin is the submodule commit.
MINIBWA_SHA=b2dcea9b43c02cef47556f993fbd54bc0002cd4a
# holodeck (fg-labs/holodeck) supplies `holodeck eval` for the truth-based
# accuracy benchmark. Public repo, so the Dockerfile cargo-installs it from
# this git ref at build time (no submodule). Pinned to the fg-labs/holodeck#21
# tip (per-contig parallel `methylate`), which is stacked on #20 and so carries
# the truth-aware `eval` work too; bump to a tagged release once they merge.
HOLODECK_REPO=https://github.com/fg-labs/holodeck
HOLODECK_REF=efae5ce6ea120df7eea6a705e2214f8647e7d8c1
# fgumi supplies `fgumi compare bams`, the full-content + header identity check
# the `--compat=bwa-mem2` arms are scored with (all 11 core SAM fields + tags,
# vs compare-bams' placement-and-tags-only comparison). Public repo, so the
# Dockerfile cargo-installs it from this git ref with `--features compare`
# (the subcommand is feature-gated off by default). Pinned to the v0.5.0 tag.
FGUMI_REPO=https://github.com/fulcrumgenomics/fgumi
FGUMI_REF=3df1022c47420b1dd23373d0283ecb9fa9cf8bc0
# tachyon (nh13/tachyon) measures a host's memory access rate under whatever
# contention exists at that moment, so host quality can be told apart from a
# code change. It exists because this fleet's wall times are not comparable
# across runs: repeating a rep on the SAME EC2 instance reproduces within 2.03%,
# while a fresh instance per rep spreads 9.40%, and the v0.9.0 bless failed a
# perf gate for a "regression" that a same-day control showed was the host.
#
# Published on crates.io, so the Dockerfile installs it by version -- same as
# tricord, and unlike holodeck/fgumi which need git refs to reach unreleased
# commits. An EXACT version, never a range: a change to what the probe MEASURES
# silently invalidates every score recorded against an earlier version, with no
# error to notice, and comparing readings across releases is the whole point.
# See fg-labs/bwa-mem3-bench#56.
TACHYON_VERSION=0.1.0
